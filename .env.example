# 复制成 .env 再填写。这里都是密钥，不要提交到仓库，也不要发给别人。

# ── QQ 开放平台（q.qq.com → 开发设置）──
QQ_APP_ID=
QQ_APP_SECRET=

# ── 落雪查分器 ──
# 开发者 API 密钥：开发者面板 → 基本信息。好友码绑定和查询都靠它
LXNS_DEV_TOKEN=
# OAuth 应用：开发者面板 → OAuth 应用 → 创建应用后显示的「应用 ID」和「应用密钥」。不填则 /授权 不可用
LXNS_OAUTH_CLIENT_ID=
LXNS_OAUTH_CLIENT_SECRET=

# ── 绑定库主密钥 ──
# Windows 上留空：第一次启动自动生成，用 DPAPI 保护存在 data/vault.key。
# 非 Windows 部署、或者迁移到别的机器时才填（32 字节 base64，迁移时用 node tools/vault-key.cjs 从旧机器导出）
ANNA_VAULT_KEY=

# ── 只有 tools/check-lxns.cjs 用 ──
# 个人 API 密钥：落雪 → 账号详情 → 第三方应用 → 个人 API 密钥。只能访问你自己账号的数据，而且可以改写你的成绩
LXNS_USER_TOKEN=
# 用开发者密钥测试时查询的好友码；留空就用个人 API 查到的你自己的好友码
LXNS_FRIEND_CODE=
